APP_NAME=EDNS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

HORIZON_NOTIFICATION_WORKERS=20
HORIZON_LOW_PRIORITY_WORKERS=2

NOTIFICATIONS_BATCH_MAX_SIZE=1000
NOTIFICATIONS_SCHEDULE_MAX_DAYS=30
NOTIFICATIONS_IDEMPOTENCY_RETENTION_HOURS=24
NOTIFICATIONS_IDEMPOTENCY_LOCK_SECONDS=30
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_BACKOFF_BASE_SECONDS=30
NOTIFICATIONS_BACKOFF_CAP_SECONDS=300
NOTIFICATIONS_BACKOFF_MAX_RETRY_AFTER_SECONDS=3600
NOTIFICATIONS_RATE_LIMIT_PER_SECOND=100
NOTIFICATIONS_RATE_LIMIT_MAX_WAIT_MS=2000
NOTIFICATIONS_STALE_WAITING_SECONDS=120
NOTIFICATIONS_STALE_PROCESSING_SECONDS=300
NOTIFICATIONS_STALE_QUEUED_SECONDS=90000
NOTIFICATIONS_CIRCUIT_WINDOW_SECONDS=60
NOTIFICATIONS_CIRCUIT_MINIMUM_ATTEMPTS=20
NOTIFICATIONS_CIRCUIT_FAILURE_RATE_PERCENT=50
NOTIFICATIONS_CIRCUIT_COOLDOWN_SECONDS=30
NOTIFICATIONS_CIRCUIT_PROBE_TIMEOUT_SECONDS=20
NOTIFICATIONS_ALERT_MAIL_TO=
NOTIFICATIONS_ALERT_THROTTLE_MINUTES=10
NOTIFICATIONS_GATEWAY_URL=
NOTIFICATIONS_GATEWAY_TIMEOUT_SECONDS=10
NOTIFICATIONS_GATEWAY_CONNECT_TIMEOUT_SECONDS=5
NOTIFICATIONS_METRICS_CACHE_SECONDS=5
NOTIFICATIONS_API_REQUESTS_PER_MINUTE=600

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
